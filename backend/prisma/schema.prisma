generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model IngredientReference {
  id          String       @id @default(uuid())
  name        String       @unique
  imageUrl    String?
  ingredients Ingredient[]
}

model Ingredient {
  id          String               @id @default(uuid())
  name        String
  quantity    Float
  unit        String
  recipeId    String
  category    IngredientCategory   @default(OTHER)
  referenceId String?
  isBought    Boolean              @default(false)
  recipe      Recipe               @relation(fields: [recipeId], references: [id])
  reference   IngredientReference? @relation(fields: [referenceId], references: [id])
}

model Recipe {
  id           String        @id @default(uuid())
  name         String
  prepTimeMin  Int?
  difficulty   String?
  calories     Float?
  proteins     Float?
  carbs        Float?
  fat          Float?
  fibers       Float?
  isVegetarian Boolean       @default(false)
  isVegan      Boolean       @default(false)
  isGlutenFree Boolean       @default(false)
  isDairyFree  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId          String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imagePath       String?
  messageId       String?         @unique
  description     String?
  instructions    String[]
  ingredients     Ingredient[]
  Message         Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  savedRecipes    SavedRecipe[]
  mealPlanEntries MealPlanEntry[]
}

model SavedRecipe {
  recipeId        String
  plannedFor      DateTime
  createdAt       DateTime @default(now())
  userId          String   @db.Uuid
  isInGroceryList Boolean  @default(false)
  isFavorite      Boolean  @default(false)
  servings        Int      @default(1)
  recipe          Recipe   @relation(fields: [recipeId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@id([recipeId, userId])
}

model User {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username        String          @unique
  createdAt       DateTime?       @default(now()) @db.Date
  updatedAt       DateTime?       @db.Date
  pushToken       String?

  chats           ChatSession[]
  recipes         Recipe[]
  savedRecipes    SavedRecipe[]
  mealPlanEntries MealPlanEntry[]
  profile         UserProfile?
}

model UserProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal                String?

  ingredientRestrictions String[] @default([])
  dietRestrictions       String[] @default([])
  aversions              String[] @default([])

  cookingLevel        String   @default("INTERMEDIATE")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ChatSession {
  id          String          @id @default(uuid())
  createdAt   DateTime        @default(now()) @db.Timestamp(6)
  title       String          @default("Chat")
  updatedAt   DateTime?       @default(now()) @updatedAt
  userId      String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  preferences PreferenceTag[]
  exclude     PreferenceTag[]
  User        User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages    Message[]
}

model Message {
  id          String      @id @default(uuid())
  chatId      String
  content     String
  role        MessageRole
  createdAt   DateTime?   @default(now()) @db.Timestamp(6)
  isRecipe    Boolean     @default(false)
  chatSession ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
  Recipe      Recipe?
}

model RecipeCache {
  id             String          @id @default(uuid())
  createdAt      DateTime        @default(now())
  aiResponseJson Json
  inputHash      String          @unique
  type           RecipeCacheType
}

enum HealthRestriction {
  GLUTEN_FREE
  DAIRY_FREE
  PEANUT_FREE
  TREE_NUT_FREE
  SHELLFISH_FREE
  EGG_FREE
  SOY_FREE
  NO_PORK
  VEGETARIAN
  VEGAN
  PESCETARIAN
  KETO
  PALEO
  NO_BEEF
}

enum IngredientCategory {
  FRUITS
  VEGETABLES
  MEAT
  FISH
  DAIRY
  PANTRY
  BAKERY
  FROZEN
  DRINKS
  OTHER
}

enum PreferenceTag {
  high_protein
  high_fiber
  low_carb
  balanced
  high_carb
  low_fat
  vegetarian
  vegan
  italian
  mexican
  mediterranean
  american
  french
  indian
  thai
  chinese
  japanese
  middle_eastern
  korean
  african
  breakfast
  lunch
  dinner
  appetizer
  dessert
  snack
  smoothie_drink
  under_15
  under_30
  one_hour_max
  slow_cook
  chicken
  beef
  pork
  fish
  seafood
  lamb
  turkey
  duck
  tomatoes
  onions
  carrots
  bell_peppers
  broccoli
  spinach
  mushrooms
  zucchini
  potatoes
  garlic
  lettuce
  cucumber
}

enum MessageRole {
  user
  model
}

enum RecipeCacheType {
  extraction
  substitution
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

model MealPlanEntry {
  id        String   @id @default(uuid())
  userId    String   @db.Uuid
  recipeId  String
  date      DateTime @db.Date
  mealType  MealType
  servings  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, date, mealType])
}
