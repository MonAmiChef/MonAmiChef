generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Ingredient {
  id       String  @id @default(uuid())
  name     String
  quantity Float
  unit     String
  category String?
  rawText  String?
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id])
}

model Recipe {
  id           String       @id @default(uuid())
  name         String
  prepTimeMin  Int?
  servings     Int?
  difficulty   String?
  calories     Float?
  proteins     Float?
  carbs        Float?
  fat          Float?
  fibers       Float?
  isVegetarian Boolean      @default(false)
  isVegan      Boolean      @default(false)
  isGlutenFree Boolean      @default(false)
  isDairyFree  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  userId       String       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredients  Ingredient[]
  user         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model User {
  username  String        @unique
  createdAt DateTime?     @default(now()) @db.Date
  updatedAt DateTime?     @db.Date
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chats     ChatSession[]
  recipes   Recipe[]
}

model ChatSession {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  title     String    @default("Chat")
  updatedAt DateTime? @default(now()) @updatedAt
  userId    String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  User      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages  Message[]
}

model Message {
  id          String      @id @default(uuid())
  chatId      String
  content     String
  role        MessageRole
  createdAt   DateTime?   @default(now()) @db.Timestamp(6)
  chatSession ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model RecipeCache {
  id             String          @id @default(uuid())
  createdAt      DateTime        @default(now())
  aiResponseJson Json
  inputHash      String          @unique
  type           RecipeCacheType
}

enum MessageRole {
  user
  model
}

enum RecipeCacheType {
  extraction
  substitution
}
