model ChatSession {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  title     String    @default("Chat")
  updatedAt DateTime? @default(now()) @updatedAt
  userId    String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  User      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages  Message[]

  preferences PreferenceTag[]
  exclude PreferenceTag[]
}

model Message {
  id          String      @id @default(uuid())
  chatId      String
  content     String
  role        MessageRole
  createdAt   DateTime?   @default(now()) @db.Timestamp(6)
  chatSession ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model RecipeCache {
  id             String          @id @default(uuid())
  createdAt      DateTime        @default(now())
  aiResponseJson Json
  inputHash      String          @unique
  type           RecipeCacheType
}

enum MessageRole {
  user
  model
}

enum RecipeCacheType {
  extraction
  substitution
}
