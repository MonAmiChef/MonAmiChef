{
  "expo": {
    "name": "MonAmiChef",
    "slug": "MonAmiChef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "MonAmiChef",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fffdfb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lenny00.MonAmiChef",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "notification": {
        "icon": "./assets/images/monamichef_bg_less-modified.png",
        "color": "#f97316"
      },
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#fffdfb"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.lenny00.MonAmiChef"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/monamichef_bg_less-modified.png",
          "color": "#f97316"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c49f9cf-2919-4af8-a32e-263d5994c4f1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1c49f9cf-2919-4af8-a32e-263d5994c4f1"
    }
  }
}
